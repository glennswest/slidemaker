#!/bin/bash
# slidemaker — narrated-video production for HTML slide decks.
#
# Usage: slidemaker <command> [args]   (run inside a directory with slidemaker.conf)
#
#   init                  write a slidemaker.conf template here
#   render                render deck slides to frames/slideNN.png
#   pdf                   export the deck to <deck>.pdf
#   record [SECS]         record mic to sample.m4a (default 90s) + level check
#   check FILE            report duration and volume levels of an audio file
#   curve [init|read]     show the curve; init seeds curve.tsv;
#                         read has a local LLM derive the emotional flow
#   tts [--force]         synthesize all slides with TTS_ENGINE into tts/
#   prosody [DIR]         measure built audio — rate and loudness variation
#   clone setup           install F5-TTS (+deps) on CLONE_HOST
#   clone ship FILE       upload a voice sample to CLONE_HOST
#   clone spans [SRC]     list candidate reference spans (Whisper, GPU)
#   clone band B SRC N    register span N as energy band B (calm|mid|hot)
#   clone ref SRC T0 T1   cut the speaker prompt (indextts, no transcript)
#   clone bands           show the registered energy bands
#   clone curve [SET]     render the excitement curve in your cloned voice
#   clone test N [SLIDE]  synthesize one slide with span N and play it
#   clone all N [SET]     synthesize every slide with span N into remote SET
#   clone fetch [SET]     download a remote SET into voice-SET/
#   video [DIR [OUT]]     assemble video; audio priority: DIR > VOICE_DIR > tts/
#   srt [DIR [OUT]]       subtitles from the narration and rendered audio
#   clean                 remove frames/ tts/ segs/ concat.txt
set -euo pipefail

SLIDEMAKER_VERSION=0.3.0
PROSODY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/slidemaker-prosody"

die() { echo "slidemaker: $*" >&2; exit 1; }

conf() {
  local f=slidemaker.conf
  # gmedia.conf is the pre-rename name; existing productions keep working.
  [ -f "$f" ] || f=gmedia.conf
  [ -f "$f" ] || die "no slidemaker.conf here (try: slidemaker init)"
  # shellcheck disable=SC1090
  source "$f"
  DECK="${DECK:?slidemaker.conf must set DECK}"
  SLIDES="${SLIDES:?slidemaker.conf must set SLIDES}"
  NARRATION_DIR="${NARRATION_DIR:-narration}"
  VOICE_DIR="${VOICE_DIR:-voice}"
  OUT_VIDEO="${OUT_VIDEO:-video.mp4}"
  PAD="${PAD:-0.9}"
  TTS_ENGINE="${TTS_ENGINE:-edge}"       # edge | say
  TTS_VOICE="${TTS_VOICE:-en-US-AndrewMultilingualNeural}"
  EDGE_TTS_BIN="${EDGE_TTS_BIN:-edge-tts}"
  CHROME="${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
  CLONE_HOST="${CLONE_HOST:-}"           # e.g. glenn@ai.g8.lo; empty = local GPU
  CLONE_DIR="${CLONE_DIR:-voiceclone}"   # remote work dir
  CLONE_VENV="${CLONE_VENV:-\$HOME/.f5venv}"  # remote venv: f5-tts + transformers
  # `CLONE_VENV=~/.f5venv` in a conf file is expanded by the *local* shell at
  # source time, so the GPU host would be handed this Mac's home directory.
  # Hand the remote shell a literal $HOME to expand itself.
  CLONE_VENV="${CLONE_VENV/#$HOME/\$HOME}"
  CLONE_VENV="${CLONE_VENV/#\~/\$HOME}"
  CLONE_STOP_SERVICE="${CLONE_STOP_SERVICE:-}" # systemd unit to pause for VRAM
  # f5       — timbre and emotion are the same knob (the reference clip), so
  #            the curve can only pick a reference per slide.
  # indextts — speaker prompt and emotion vector are separate inputs, so the
  #            curve drives emotion with your voice held fixed.
  CLONE_ENGINE="${CLONE_ENGINE:-indextts}"  # indextts | f5
  INDEXTTS_DIR="${INDEXTTS_DIR:-index-tts}"   # checkout on CLONE_HOST
  CLONE_REF="${CLONE_REF:-refs/speaker.wav}"  # speaker prompt (indextts)
  CLONE_MODE="${CLONE_MODE:-slide}"      # slide | arc | sentence (indextts)
  # A neighbour on the same GPU that can shrink on request rather than be
  # stopped, e.g. http://ai.g8.lo:8090 (llmpager >= 0.19). Borrowed VRAM is
  # always given back, including on interrupt.
  GPU_LENDER="${GPU_LENDER:-}"
  GPU_LENT_SLOTS=""
  # Scales the whole emotion axis. The usable range is narrow: 1.0 puts full
  # curve energy at about happy=0.30, which is a lift, not a performance.
  EMO_GAIN="${EMO_GAIN:-1.6}"
  # Tempo at energy 0 : 1. The front of a slide is the quiet part and should
  # not outrun the payoff; widen this if an opening still sounds rushed.
  SM_TEMPO="${SM_TEMPO:-0.86:1.06}"
  EMO_RUNS="${EMO_RUNS:-3}"              # max continuous runs per slide (arc)
  # Excitement curve (see slidemaker-prosody). off = the old flat one-shot TTS.
  EXCITEMENT="${EXCITEMENT:-curve}"      # curve | off
  CURVE_FILE="${CURVE_FILE:-curve.tsv}"  # inside NARRATION_DIR
  CURVE_DEFAULT="${CURVE_DEFAULT:-auto}" # auto | 0.0-1.0
  # `slidemaker curve read` has a local model read the narration and write
  # the emotional flow to NARRATION_DIR/curve.json.
  LLM_URL="${LLM_URL:-http://ai.g8.lo:8090/v1/chat/completions}"
  LLM_MODEL="${LLM_MODEL:-qwen3-30b-a3b}"
  LLM_BATCH="${LLM_BATCH:-4}"            # slides per annotation request
  LLM_TIMEOUT="${LLM_TIMEOUT:-300}"      # seconds per request
  # Same session for every request in a deck: the shared system prompt is
  # prefilled once by the server rather than re-read for each slide.
  LLM_SESSION="${LLM_SESSION:-slidemaker}"
  # The model ranks sentences well but compresses the scale; this stretches
  # its readings deck-wide onto a usable span. Empty keeps them as given.
  E_EXPAND="${E_EXPAND:-0.25:0.95}"
  LLM_RESTART="${LLM_RESTART:-}"         # escape hatch, normally empty
  # Loudness is the excitement lever. Rate moves a little and eases back at
  # the peak; pitch barely moves at all — pushing rate and pitch up together
  # is what makes synthetic narration speed up and turn nasal.
  E_RATE="${E_RATE:--2:9}"               # percent   at energy 0 : 1
  E_PITCH="${E_PITCH:--1:3}"             # Hz        at energy 0 : 1
  E_VOLUME="${E_VOLUME:-0:12}"           # percent   at energy 0 : 1
  E_GAP="${E_GAP:-0.34:0.15}"            # seconds between sentences, 0 : 1
  E_JITTER="${E_JITTER:-on}"
}

# Export config for the Python prosody engine.
prosody_env() {
  export SM_NARRATION_DIR="$NARRATION_DIR" SM_TTS_DIR=tts SM_SLIDES="$SLIDES" \
         SM_TTS_VOICE="$TTS_VOICE" SM_EDGE_TTS_BIN="$EDGE_TTS_BIN" \
         SM_CURVE_FILE="$CURVE_FILE" SM_CURVE_DEFAULT="$CURVE_DEFAULT" \
         SM_E_RATE="$E_RATE" SM_E_PITCH="$E_PITCH" SM_E_VOLUME="$E_VOLUME" \
         SM_E_GAP="$E_GAP" SM_E_JITTER="$E_JITTER" \
         SM_LLM_URL="$LLM_URL" SM_LLM_MODEL="$LLM_MODEL" \
         SM_LLM_BATCH="$LLM_BATCH" SM_LLM_TIMEOUT="$LLM_TIMEOUT" \
         SM_LLM_SESSION="$LLM_SESSION" SM_LLM_RESTART="$LLM_RESTART" \
         SM_E_EXPAND="$E_EXPAND"
}

nn() { printf "%02d" "$1"; }

cmd_init() {
  [ -f slidemaker.conf ] && die "slidemaker.conf already exists"
  cat > slidemaker.conf <<'EOF'
# slidemaker production config (shell syntax). Paths relative to this file.
DECK=deck.html          # slides addressable as deck.html#N (1-based)
SLIDES=20
NARRATION_DIR=narration # slideNN.txt per slide
VOICE_DIR=voice         # optional human recordings slideNN.(m4a|wav|mp3|aiff)
OUT_VIDEO=video.mp4
PAD=0.9                 # silence seconds appended per slide
TTS_ENGINE=edge         # edge | say
TTS_VOICE=en-US-AndrewMultilingualNeural
#EDGE_TTS_BIN=/path/to/edge-tts

# Excitement curve — the difference between narration and a robot reading.
# Energy 0.0-1.0 per sentence drives loudness, pause length, and (gently)
# rate. Sources, highest first: [e=..] markers in the narration text, then
# NARRATION_DIR/curve.tsv, then CURVE_DEFAULT.
EXCITEMENT=curve        # curve | off (off = one flat pass per slide)
CURVE_DEFAULT=auto      # auto talk arc, or a fixed 0.0-1.0
#CURVE_FILE=curve.tsv
#E_VOLUME=0:12          # volume percent at energy 0 : 1 — the main lever
#E_RATE=-2:9            # speech rate percent at energy 0 : 1
#E_PITCH=-1:3           # pitch Hz at energy 0 : 1 — keep small, see README
#E_GAP=0.34:0.15        # pause seconds between sentences at energy 0 : 1
#E_JITTER=on            # per-sentence micro-variation (deterministic)

# Voice cloning (optional): a Linux GPU host reachable over ssh.
# Your own voice at three energy levels beats any prosody tuning — see
# "Excitement in your own voice" in the README.
#CLONE_HOST=user@gpubox
#CLONE_VENV=~/.f5venv
#CLONE_STOP_SERVICE=llmpager   # systemd unit to stop during GPU synthesis
EOF
  echo "wrote slidemaker.conf — edit it, then: slidemaker render && slidemaker tts && slidemaker video"
}

cmd_render() {
  conf; mkdir -p frames
  for i in $(seq 1 "$SLIDES"); do
    local out="frames/slide$(nn "$i").png"
    [ -f "$out" ] && continue
    "$CHROME" --headless=new --disable-gpu --hide-scrollbars \
      --window-size=1920,1080 --screenshot="$out" \
      "file://$PWD/$DECK#$i" >/dev/null 2>&1
    echo "$out"
  done
}

cmd_pdf() {
  conf
  "$CHROME" --headless=new --disable-gpu --no-pdf-header-footer \
    --print-to-pdf="$PWD/${DECK%.html}.pdf" "file://$PWD/$DECK" 2>&1 | tail -1
}

cmd_record() {
  conf
  local secs="${1:-90}"
  echo "recording ${secs}s from the default mic — speak after this line"
  ffmpeg -v error -y -f avfoundation -i ":0" -t "$secs" -ar 24000 -ac 1 sample.m4a
  cmd_check sample.m4a
  echo "if max_volume is quieter than -25 dB the mic isn't really capturing;"
  echo "check System Settings > Privacy > Microphone and input device/volume."
}

cmd_check() {
  local f="${1:?usage: slidemaker check FILE}"
  ffprobe -v error -show_entries format=duration -of csv=p=0 "$f"
  ffmpeg -i "$f" -af volumedetect -f null - 2>&1 | grep -E "mean_volume|max_volume"
}

cmd_curve() {
  conf; prosody_env
  case "${1:-}" in
    init) shift; "$PROSODY" curve-init "$@" ;;
    read) shift; "$PROSODY" annotate "$@" ;;   # local model reads the script
    *)    "$PROSODY" plan "$@" ;;
  esac
}

cmd_prosody() { conf; prosody_env; "$PROSODY" report "$@"; }

cmd_tts() {
  conf; mkdir -p tts
  if [ "$TTS_ENGINE" = edge ] && [ "$EXCITEMENT" != off ]; then
    prosody_env; "$PROSODY" synth "$@"; return
  fi
  for i in $(seq 1 "$SLIDES"); do
    local n; n=$(nn "$i")
    local txt="$NARRATION_DIR/slide$n.txt"
    [ -f "$txt" ] || die "missing $txt"
    # Curve markers are direction for the engine, not words to be spoken —
    # strip them before any backend that reads the file verbatim.
    local plain; plain=$(mktemp -t slidemaker)
    strip_markers "$txt" > "$plain"
    if [ "$TTS_ENGINE" = edge ]; then
      [ -f "tts/slide$n.mp3" ] && { rm -f "$plain"; continue; }
      "$EDGE_TTS_BIN" --voice "$TTS_VOICE" --rate=+3% \
        --file "$plain" --write-media "tts/slide$n.mp3" >/dev/null 2>&1
      echo "tts/slide$n.mp3"
    else
      [ -f "tts/slide$n.aiff" ] && { rm -f "$plain"; continue; }
      say -v "$TTS_VOICE" -o "tts/slide$n.aiff" -f "$plain"
      echo "tts/slide$n.aiff"
    fi
    rm -f "$plain"
  done
}

# Strip curve markers. The pattern lives in slidemaker-prosody only — a
# second copy here drifted once and the markers were spoken aloud.
strip_markers() { "$PROSODY" strip "$1"; }

# With CLONE_HOST empty the GPU is this machine: run locally and skip the
# ssh/scp hops entirely. The renderers only ever needed a plan and a
# working directory, never a remote.
clone_local() { conf; [ -z "$CLONE_HOST" ]; }

clone_ssh() {
  conf
  if clone_local; then bash -c "$*"; return; fi
  ssh -o BatchMode=yes "$CLONE_HOST" "$@"
}

# Copy into the work dir, locally or remotely.
clone_put() {
  conf; mkdir -p "$CLONE_DIR" 2>/dev/null || true
  if clone_local; then cp "$1" "$CLONE_DIR/$2"; else scp -q "$1" "$CLONE_HOST:$CLONE_DIR/$2"; fi
}

cmd_clone() {
  local sub="${1:?usage: slidemaker clone <setup|ship|spans|test|all|fetch>}"; shift || true
  case "$sub" in
  setup)
    conf
    clone_ssh "python3 -m venv $CLONE_VENV 2>/dev/null; $CLONE_VENV/bin/pip install -q f5-tts && echo f5-ready"
    ;;
  ship)
    conf; local f="${1:?usage: slidemaker clone ship FILE}"
    scp -q "$f" "$CLONE_HOST:$CLONE_DIR/memo.src"
    clone_ssh "mkdir -p $CLONE_DIR && cd $CLONE_DIR && ffmpeg -v error -y -i memo.src -ar 24000 -ac 1 memo.wav && echo shipped"
    scp -q -r "$NARRATION_DIR" "$CLONE_HOST:$CLONE_DIR/narration"
    ;;
  spans)
    conf; local src="${1:-memo}"
    clone_ssh "cd $CLONE_DIR && SRC=$src $CLONE_VENV/bin/python - <<'PYEOF'
from transformers import pipeline
import json, os, subprocess
src = os.environ['SRC']
asr = pipeline('automatic-speech-recognition', model='openai/whisper-base.en', return_timestamps=True, device='cuda')
chunks = asr(src + '.wav')['chunks']
cands = []
for i in range(len(chunks)):
    t0 = chunks[i]['timestamp'][0]
    if t0 is None or t0 < 3:
        continue
    text, t1 = '', t0
    for j in range(i, len(chunks)):
        if chunks[j]['timestamp'][1] is None:
            break
        t1 = chunks[j]['timestamp'][1]
        text += chunks[j]['text']
        if 9.5 <= t1 - t0 <= 12.0:
            cands.append((t0, t1, text.strip()))
            break
json.dump(cands, open('spans-' + src + '.json', 'w'))
for k, (t0, t1, text) in enumerate(cands, 1):
    print(k, round(t0, 1), round(t1, 1), '|', text[:70])
PYEOF"
    ;;
  band)
    # Register one energy band of your own voice as a clone reference.
    conf
    local name="${1:?usage: slidemaker clone band <calm|mid|hot> SOURCE N}"
    local src="${2:?usage: slidemaker clone band <calm|mid|hot> SOURCE N}"
    local k="${3:?usage: slidemaker clone band <calm|mid|hot> SOURCE N}"
    case "$name" in calm|mid|hot) ;; *) die "band must be calm, mid or hot" ;; esac
    clone_ssh "cd $CLONE_DIR && mkdir -p refs && $CLONE_VENV/bin/python -c \"
import json
c = json.load(open('spans-$src.json'))[$k-1]
import subprocess
subprocess.run(['ffmpeg','-v','error','-y','-i','$src.wav','-ss',str(c[0]),'-to',str(c[1]),'refs/$name.wav'], check=True)
open('refs/$name.txt','w').write(c[2])
print('$name <- $src span $k  %.1fs  %s' % (c[1]-c[0], c[2][:60]))\""
    ;;
  bands)
    conf
    clone_ssh "cd $CLONE_DIR && for b in calm mid hot; do
      if [ -f refs/\$b.wav ]; then
        printf '%-5s %5.1fs  ' \$b \$(ffprobe -v error -show_entries format=duration -of csv=p=0 refs/\$b.wav)
        head -c 60 refs/\$b.txt; echo
      else echo \"\$b   (not set)\"; fi
    done"
    ;;
  ref)
    # Cut a speaker prompt. IndexTTS-2 needs no transcript for this — it
    # takes identity from the audio alone — so any clean stretch will do.
    conf
    local src="${1:?usage: slidemaker clone ref SOURCE START END}"
    local t0="${2:?usage: slidemaker clone ref SOURCE START END}"
    local t1="${3:?usage: slidemaker clone ref SOURCE START END}"
    clone_ssh "cd $CLONE_DIR && mkdir -p refs && ffmpeg -v error -y -i $src.wav -ss $t0 -to $t1 -ar 24000 -ac 1 refs/speaker.wav && ffmpeg -i refs/speaker.wav -af volumedetect -f null - 2>&1 | grep -E 'mean_volume|max_volume'"
    ;;
  curve)
    # Render the excitement plan in your own voice.
    conf; prosody_env
    local set="${1:-curve}"; shift || true
    local plan; plan=$(mktemp -t slidemaker-plan)
    "$PROSODY" json "$@" > "$plan" || die "could not build the plan"
    local nseg; nseg=$(python3 -c "import json,sys; p=json.load(open('$plan')); print(sum(len(s['segments']) for s in p['slides']))")
    echo "plan: $nseg sentences -> $CLONE_HOST ($CLONE_ENGINE)"
    clone_put "$plan" plan.json
    rm -f "$plan"
    local stop="" start="" run=""
    if [ -n "$CLONE_STOP_SERVICE" ]; then
      stop="sudo systemctl stop $CLONE_STOP_SERVICE;"
      start="sudo systemctl start $CLONE_STOP_SERVICE;"
    fi
    case "$CLONE_ENGINE" in
      f5)
        clone_put "$(dirname "$PROSODY")/slidemaker-clone-curve.py" slidemaker-clone-curve.py
        run="$CLONE_VENV/bin/python slidemaker-clone-curve.py plan.json $set"
        ;;
      indextts)
        clone_put "$(dirname "$PROSODY")/slidemaker-clone-indextts.py" slidemaker-clone-indextts.py
        # Run from the checkout so the package and checkpoints resolve.
        run="cd \$HOME/$INDEXTTS_DIR && PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True SM_E_VALENCE=${E_VALENCE:-auto} SM_EMO_RUNS=$EMO_RUNS SM_TEMPO=$SM_TEMPO SM_EMO_GAIN=$EMO_GAIN INDEXTTS_CKPT=\$HOME/$INDEXTTS_DIR/checkpoints \$HOME/.local/bin/uv run python \$HOME/$CLONE_DIR/slidemaker-clone-indextts.py \$HOME/$CLONE_DIR/plan.json \$HOME/$CLONE_DIR/$set --ref \$HOME/$CLONE_DIR/$CLONE_REF --mode $CLONE_MODE"
        ;;
      *) die "CLONE_ENGINE must be f5 or indextts (got $CLONE_ENGINE)" ;;
    esac
    gpu_check "$CLONE_ENGINE" || return 1
    trap 'gpu_return' EXIT INT TERM
    clone_ssh "cd $CLONE_DIR && $stop ($run); rc=\$?; $start exit \$rc"
    gpu_return; trap - EXIT INT TERM
    mkdir -p "voice-$set"
    if clone_local; then cp "$CLONE_DIR/$set"/slide*.wav "voice-$set/"
    else scp -q "$CLONE_HOST:$CLONE_DIR/$set/slide*.wav" "voice-$set/"; fi
    echo "into voice-$set/ — build with: slidemaker video voice-$set"
    ;;
  test)
    conf; local k="${1:?usage: slidemaker clone test SPAN [SLIDE]}"; local slide="${2:-$SLIDES}"
    local n; n=$(nn "$slide")
    clone_ssh "cd $CLONE_DIR && $CLONE_VENV/bin/python -c \"
import json, subprocess
c = json.load(open('spans.json'))[$k-1]
subprocess.run(['ffmpeg','-v','error','-y','-i','memo.wav','-ss',str(c[0]),'-to',str(c[1]),'ref.wav'], check=True)
open('reftext.txt','w').write(c[2])\" && $CLONE_VENV/bin/f5-tts_infer-cli --model F5TTS_v1_Base --ref_audio ref.wav --ref_text \"\$(cat reftext.txt)\" --gen_text \"\$(cat narration/slide$n.txt)\" --output_dir out --output_file test.wav >/dev/null 2>&1 && echo synth-ok"
    scp -q "$CLONE_HOST:$CLONE_DIR/out/test.wav" /tmp/slidemaker-clone-test.wav
    afplay /tmp/slidemaker-clone-test.wav
    ;;
  all)
    conf; local k="${1:?usage: slidemaker clone all SPAN [SET]}"; local set="${2:-set$k}"
    local stop="" start=""
    if [ -n "$CLONE_STOP_SERVICE" ]; then
      stop="sudo systemctl stop $CLONE_STOP_SERVICE;"
      start="sudo systemctl start $CLONE_STOP_SERVICE;"
    fi
    clone_ssh "cd $CLONE_DIR && $stop $CLONE_VENV/bin/python -c \"
import json, subprocess
c = json.load(open('spans.json'))[$k-1]
subprocess.run(['ffmpeg','-v','error','-y','-i','memo.wav','-ss',str(c[0]),'-to',str(c[1]),'ref.wav'], check=True)
open('reftext.txt','w').write(c[2])\" && mkdir -p $set && for f in narration/slide*.txt; do n=\$(basename \$f .txt); $CLONE_VENV/bin/f5-tts_infer-cli --model F5TTS_v1_Base --ref_audio ref.wav --ref_text \"\$(cat reftext.txt)\" --gen_text \"\$(cat \$f)\" --output_dir $set --output_file \$n.wav >/dev/null 2>&1; echo \$n; done; $start echo set-done"
    ;;
  fetch)
    conf; local set="${1:-set1}"
    mkdir -p "voice-$set"
    scp -q "$CLONE_HOST:$CLONE_DIR/$set/slide*.wav" "voice-$set/"
    echo "fetched $(ls "voice-$set" | wc -l | tr -d ' ') files into voice-$set/"
    ;;
  *) die "unknown clone subcommand $sub" ;;
  esac
}

# Free VRAM needed per engine, MiB. Measured, not guessed: IndexTTS-2
# peaked at 5.55 GiB and then died asking for 20 MiB more.
engine_vram() { case "$1" in indextts) echo 7500 ;; *) echo 4000 ;; esac; }

# Refuse to start a render that cannot fit, and say what is holding the
# card. slidemaker does not own this GPU: it must never kill or stop a
# process it did not start, so this reports and stops.
gpu_check() {
  local need; need=$(engine_vram "$1")
  local free q="nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits"
  if clone_local; then free=$($q 2>/dev/null | head -1)
  else free=$(ssh -o BatchMode=yes "$CLONE_HOST" "$q" 2>/dev/null | head -1); fi
  [ -n "$free" ] || { echo "slidemaker: could not read GPU memory on $CLONE_HOST" >&2; return 0; }
  [ "$free" -ge "$need" ] && return 0
  # A neighbour may be willing to shrink rather than be stopped.
  if gpu_borrow "$need"; then
    if clone_local; then free=$($q 2>/dev/null | head -1)
    else free=$(ssh -o BatchMode=yes "$CLONE_HOST" "$q" 2>/dev/null | head -1); fi
    [ -n "$free" ] && [ "$free" -ge "$need" ] && return 0
    echo "slidemaker: still only ${free:-?} MiB free after asking" >&2
    gpu_return >&2
  fi
  echo "slidemaker: $free MiB free on ${CLONE_HOST#*@}, $1 needs ~$need MiB" >&2
  { clone_local && bash -s || ssh -o BatchMode=yes "$CLONE_HOST" 'bash -s'; } >&2 2>/dev/null <<'REMOTE' || true
nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader |
while IFS=, read -r pid mem; do
  pid=${pid// /}
  printf '  pid %-8s %10s  %s\n' "$pid" "${mem# }" "$(ps -o cmd= -p "$pid" 2>/dev/null | cut -c1-58)"
done
REMOTE
  echo "slidemaker: free memory on that GPU and retry — slidemaker will not stop what it did not start" >&2
  [ -n "$GPU_LENDER" ] && echo "slidemaker: or let it borrow: GPU_LENDER=$GPU_LENDER (asked for ${need} MiB)" >&2
  return 1
}

# Borrow VRAM from a neighbour that can shrink on request, instead of
# stopping it. llmpager >= 0.19 exposes this; anything with the same two
# endpoints works. Returns 0 if it borrowed (so the caller knows to give
# it back), 1 otherwise.
gpu_borrow() {
  [ -n "$GPU_LENDER" ] || return 1
  local need="$1" head
  head=$(curl -s -m 10 "$GPU_LENDER/v1/admin/vram") || return 1
  GPU_LENT_SLOTS=$(printf '%s' "$head" | python3 -c "
import json,sys
try: print(json.load(sys.stdin)['warm'][0]['slots'])
except Exception: print('')" 2>/dev/null)
  [ -n "$GPU_LENT_SLOTS" ] || return 1
  # nvidia-smi reports slightly less free than the lender does, so asking
  # for exactly `need` lands just short of the bar we then check against.
  local ask=$((need + 600))
  echo "slidemaker: asking $GPU_LENDER for ${ask} MiB (it holds ${GPU_LENT_SLOTS} slots)"
  curl -s -m 120 -X POST "$GPU_LENDER/v1/admin/slots" \
    -H 'Content-Type: application/json' -d "{\"reserve_mb\":$ask}" >/dev/null || return 1
  return 0
}

# Give back exactly what was borrowed. The reserve is a floor and clamps
# any later target, so it must be cleared before the slot count is
# restored — otherwise the restore is silently ignored.
gpu_return() {
  [ -n "$GPU_LENDER" ] && [ -n "${GPU_LENT_SLOTS:-}" ] || return 0
  curl -s -m 120 -X POST "$GPU_LENDER/v1/admin/slots" \
    -H 'Content-Type: application/json' -d '{"reserve_mb":500}' >/dev/null || true
  curl -s -m 120 -X POST "$GPU_LENDER/v1/admin/slots" \
    -H 'Content-Type: application/json' -d "{\"target\":$GPU_LENT_SLOTS}" >/dev/null || true
  echo "slidemaker: returned $GPU_LENDER to ${GPU_LENT_SLOTS} slots"
  GPU_LENT_SLOTS=""
}

cmd_video() {
  conf
  local vdir="${1:-$VOICE_DIR}" out="${2:-$OUT_VIDEO}"
  cmd_render >/dev/null
  mkdir -p segs; rm -f segs/*.mp4 concat.txt
  local used="" src=
  for i in $(seq 1 "$SLIDES"); do
    local n; n=$(nn "$i") aud=""
    for ext in m4a wav aiff mp3; do
      [ -f "$vdir/slide$n.$ext" ] && aud="$vdir/slide$n.$ext" && break
    done
    if [ -z "$aud" ]; then
      for ext in m4a wav aiff mp3; do
        [ -f "$VOICE_DIR/slide$n.$ext" ] && aud="$VOICE_DIR/slide$n.$ext" && break
      done
    fi
    [ -z "$aud" ] && for ext in mp3 aiff; do
      [ -f "tts/slide$n.$ext" ] && aud="tts/slide$n.$ext" && break
    done
    [ -n "$aud" ] || die "no audio for slide $n (run slidemaker tts, or add $vdir/slide$n.*)"
    case "$aud" in
      "$vdir"/*)       src=cloned  ;;
      "$VOICE_DIR"/*)  src=recorded ;;
      tts/*)           src=tts     ;;
      *)               src=other   ;;
    esac
    used="$used $src"
    local dur total
    dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$aud")
    total=$(python3 -c "print(f'{float('$dur') + $PAD:.2f}')")
    # 20ms fades kill boundary clicks; audio is re-encoded once at concat.
    local fadeout
    fadeout=$(python3 -c "print(f'{float('$dur') - 0.02:.3f}')")
    ffmpeg -v error -y -loop 1 -framerate 30 -i "frames/slide$n.png" -i "$aud" \
      -af "afade=t=in:d=0.02,afade=t=out:st=$fadeout:d=0.02,apad=pad_dur=$PAD" -t "$total" \
      -c:v libx264 -tune stillimage -pix_fmt yuv420p -r 30 \
      -c:a aac -b:a 192k -ar 48000 "segs/slide$n.mp4"
    echo "file 'segs/slide$n.mp4'" >> concat.txt
    printf 'slide %s: %6ss  %-8s %s\n' "$n" "$total" "$src" "$aud"
  done
  # Video segments are codec-identical (copy); audio is re-encoded into one
  # continuous stream so AAC priming gaps can't click at slide boundaries.
  ffmpeg -v error -y -f concat -safe 0 -i concat.txt -c:v copy -c:a aac -b:a 192k "$out"
  ffprobe -v error -show_entries format=duration,size -of default=nw=1 "$out"
  # Which backend actually spoke each slide. A slide that quietly fell
  # back to TTS on a deck of recordings is otherwise invisible.
  echo "voices: $(for v in $used; do echo "$v"; done | sort | uniq -c \
    | awk '{printf "%s %s  ", $1, $2}')"
  echo "wrote $out"
}

# Subtitles straight from the plan: sentence text plus each slide's
# rendered duration. Cue lengths are apportioned by word count and the
# planned pauses, which is close enough for narration without dragging in
# forced alignment.
cmd_srt() {
  conf; prosody_env
  local vdir="${1:-$VOICE_DIR}" out="${2:-${OUT_VIDEO%.mp4}.srt}"
  local plan; plan=$(mktemp -t slidemaker-plan)
  "$PROSODY" json > "$plan" || die "could not build the plan"
  python3 - "$plan" "$vdir" "$VOICE_DIR" "$PAD" "$out" <<'PY'
import json, subprocess, sys, os
plan, vdir, voice_dir, pad, out = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4]), sys.argv[5]
deck = json.load(open(plan))['slides']

def audio_for(n):
    for d in (vdir, voice_dir, 'tts'):
        for ext in ('m4a', 'wav', 'aiff', 'mp3'):
            p = os.path.join(d, f'slide{n}.{ext}')
            if os.path.exists(p):
                return p
    return None

def stamp(t):
    ms = int(round(t * 1000))
    h, ms = divmod(ms, 3600000); m, ms = divmod(ms, 60000); s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"

cues, idx, clock = [], 1, 0.0
for slide in deck:
    aud = audio_for(slide['slide'])
    if not aud:
        continue
    dur = float(subprocess.run(['ffprobe', '-v', 'error', '-show_entries',
                                'format=duration', '-of', 'csv=p=0', aud],
                               capture_output=True, text=True).stdout.strip() or 0)
    segs = slide['segments']
    gaps = sum(s['gap'] for s in segs)
    words = sum(max(1, len(s['text'].split())) for s in segs)
    # Speech time is whatever the pauses did not take.
    speech = max(0.1, dur - min(gaps, dur * 0.5))
    t = clock
    for s in segs:
        w = max(1, len(s['text'].split()))
        span = speech * w / words
        cues.append((idx, t, t + span, s['text'])); idx += 1
        t += span + s['gap'] * (min(gaps, dur * 0.5) / gaps if gaps else 0)
    clock += dur + pad

with open(out, 'w') as fh:
    for i, a, b, text in cues:
        fh.write(f"{i}\n{stamp(a)} --> {stamp(b)}\n{text}\n\n")
print(f"wrote {out} ({len(cues)} cues, {stamp(clock)})")
PY
  rm -f "$plan"
}

cmd_clean() { rm -rf frames tts segs concat.txt; echo cleaned; }

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  render) shift; cmd_render "$@" ;;
  pdf) shift; cmd_pdf "$@" ;;
  record) shift; cmd_record "$@" ;;
  check) shift; cmd_check "$@" ;;
  curve) shift; cmd_curve "$@" ;;
  tts) shift; cmd_tts "$@" ;;
  prosody) shift; cmd_prosody "$@" ;;
  clone) shift; cmd_clone "$@" ;;
  video) shift; cmd_video "$@" ;;
  srt) shift; cmd_srt "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  version|--version) echo "slidemaker $SLIDEMAKER_VERSION" ;;
  *) grep '^#' "$0" | sed -n '2,25p' | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
