#!/usr/bin/env python3
"""slidemaker-prosody — excitement-curve narration engine.

The reason one-shot TTS sounds like a machine is not voice quality, it is
invariance: a whole slide synthesized at one rate, one pitch, one volume,
with identical pauses at every sentence. No speaker alive does that.

This engine synthesizes a slide one *sentence* at a time, each at its own
prosody, and rejoins them with pauses it computes from the shape of the
script. Energy comes from the script itself:

    [e=0.5] Hi, I'm Glen West. Two days ago I showed you L.L.M. Pager
    running a thirty billion parameter model on a sixteen gigabyte card.
    [e=0.95] Today the headline is bigger. A lot bigger.
    [e=0.6>0.9] This is Kimi K two point six. One trillion parameters.

    [e=0.5] Markers: [e=N] sets energy, [e=A>B] ramps across the lines
    that follow, [beat] or [beat=0.8] holds a silence.

Unmarked narration still works: the slide takes its energy from
curve.tsv, or from an automatic talk-shaped arc across the deck.

Commands: plan | synth | curve-init | report
"""

import argparse
import hashlib
import json
import math
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

# ---------------------------------------------------------------- config

def _pair(env, default):
    """Read a 'LOW:HIGH' env var into a float pair (value at e=0, at e=1)."""
    raw = os.environ.get(env) or default
    try:
        lo, hi = raw.replace('%', '').replace('Hz', '').split(':')
        return float(lo), float(hi)
    except ValueError:
        die(f"{env} must look like LOW:HIGH (got {raw!r})")


def die(msg):
    print(f"slidemaker-prosody: {msg}", file=sys.stderr)
    sys.exit(1)


class Config:
    def __init__(self):
        self.narration = Path(os.environ.get('SM_NARRATION_DIR', 'narration'))
        self.tts_dir = Path(os.environ.get('SM_TTS_DIR', 'tts'))
        self.slides = int(os.environ.get('SM_SLIDES', '0') or 0)
        self.voice = os.environ.get('SM_TTS_VOICE', 'en-US-AndrewMultilingualNeural')
        self.edge_bin = os.environ.get('SM_EDGE_TTS_BIN', 'edge-tts')
        self.curve_file = os.environ.get('SM_CURVE_FILE', 'curve.tsv')
        self.curve_default = os.environ.get('SM_CURVE_DEFAULT', 'auto')
        # Prosody at e=0 : e=1.
        #
        # Excitement is NOT "faster and higher". Pushing rate and pitch up
        # together is what makes synthetic narration speed up and go nasal.
        # Real speakers get louder, pause before the important line, and
        # slow down on the payoff so it lands. So: volume is the main lever
        # and is monotonic; rate and pitch follow EASE below, which peaks at
        # three-quarter energy and eases back at the top; pitch travel is
        # kept small because shifting a neural voice's pitch is exactly the
        # artefact that reads as nasal.
        self.rate = _pair('SM_E_RATE', '-2:9')       # percent
        self.pitch = _pair('SM_E_PITCH', '-1:3')     # Hz
        self.volume = _pair('SM_E_VOLUME', '0:12')   # percent
        self.gap = _pair('SM_E_GAP', '0.34:0.15')    # seconds between sentences
        self.jitter = (os.environ.get('SM_E_JITTER', 'on').lower()
                       not in ('off', '0', 'false', 'no'))
        self.rise = float(os.environ.get('SM_E_RISE', '0.10'))
        self.max_words = int(os.environ.get('SM_E_MAX_WORDS', '32'))


# ------------------------------------------------------- sentence splitting

# Words whose trailing period never ends a sentence.
ABBREV = {
    'mr', 'mrs', 'ms', 'dr', 'prof', 'sr', 'jr', 'st', 'vs', 'etc', 'eg',
    'ie', 'approx', 'fig', 'no', 'inc', 'ltd', 'co', 'corp', 'dept', 'est',
    'al', 'ca', 'cf', 'min', 'max', 'sec', 'ver', 'vol',
}

# "L.L.M." / "U.S." / "K." — an initialism, not a sentence end. These are all
# over technical narration ("L.L.M. Pager", "N.V.M.e."), and splitting inside
# one produces a fragment the TTS reads as its own gasping sentence.
INITIALISM = re.compile(r'^(?:[A-Za-z]\.)+$')

BOUNDARY = re.compile(r'([.!?]+["\')\]]*)(\s+)')


def split_sentences(text, max_words):
    """Split into sentences, protecting abbreviations and initialisms."""
    text = text.strip()
    if not text:
        return []
    out, start = [], 0
    for m in BOUNDARY.finditer(text):
        tok_m = re.search(r'\S+$', text[:m.end(1)])
        tok = tok_m.group() if tok_m else ''
        if INITIALISM.match(tok):
            continue
        if tok.rstrip('.!?"\')]').lower().replace('.', '') in ABBREV:
            continue
        nxt = text[m.end():m.end() + 1]
        if nxt and not (nxt.isupper() or nxt.isdigit() or nxt in '"\'('):
            continue
        out.append(text[start:m.end(1)].strip())
        start = m.end()
    tail = text[start:].strip()
    if tail:
        out.append(tail)
    return [s for part in out for s in _cap_length(part, max_words)]


def _cap_length(sentence, max_words):
    """A 50-word sentence at one prosody is still flat — break it at a comma."""
    words = sentence.split()
    if len(words) <= max_words:
        return [sentence]
    commas = [i for i, w in enumerate(words) if w.endswith(',')]
    mid = len(words) // 2
    best = min((c for c in commas if 5 <= c + 1 <= len(words) - 6),
               key=lambda c: abs(c - mid), default=None)
    if best is None:
        return [sentence]
    head, tail = ' '.join(words[:best + 1]), ' '.join(words[best + 1:])
    return _cap_length(head, max_words) + _cap_length(tail, max_words)


# ------------------------------------------------------------ curve sources

MARKER = re.compile(
    r'\[\s*(?:e\s*=\s*([0-9]*\.?[0-9]+)\s*(?:>\s*([0-9]*\.?[0-9]+))?'
    r'|beat(?:\s*=\s*([0-9]*\.?[0-9]+))?)\s*\]', re.I)

# Anchors of the default talk arc: open with a hook, settle into the
# explanation, build to the payoff about three-quarters through, land warm.
ARC = [(0.00, 0.70), (0.15, 0.48), (0.75, 0.90), (1.00, 0.66)]


def auto_arc(index, total):
    if total <= 1:
        return 0.70
    p = (index - 1) / (total - 1)
    for (p0, e0), (p1, e1) in zip(ARC, ARC[1:]):
        if p <= p1:
            t = 0.0 if p1 == p0 else (p - p0) / (p1 - p0)
            return e0 + (e1 - e0) * t
    return ARC[-1][1]


def load_curve(cfg):
    """slideNN -> (start, end) energy, from NARRATION_DIR/curve.tsv."""
    path = cfg.narration / cfg.curve_file
    curve = {}
    if not path.exists():
        return curve
    for lineno, line in enumerate(path.read_text().splitlines(), 1):
        line = line.split('#', 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 2:
            die(f"{path}:{lineno}: expected 'SLIDE ENERGY'")
        slide, spec = parts
        try:
            if '>' in spec:
                a, b = (float(x) for x in spec.split('>', 1))
            else:
                a = b = float(spec)
        except ValueError:
            die(f"{path}:{lineno}: bad energy {spec!r}")
        curve[int(slide)] = (clamp(a), clamp(b))
    return curve


def clamp(e):
    return max(0.0, min(1.0, e))


# How rate and pitch track energy. Not a straight line: speech quickens as a
# speaker warms up, then *slows* on the peak line so it lands. Mapping energy
# straight through to rate is what produces the breathless, nasal read.
EASE = [(0.00, 0.00), (0.50, 0.75), (0.75, 1.00), (1.00, 0.45)]


def ease(e):
    for (x0, y0), (x1, y1) in zip(EASE, EASE[1:]):
        if e <= x1:
            t = 0.0 if x1 == x0 else (e - x0) / (x1 - x0)
            return y0 + (y1 - y0) * t
    return EASE[-1][1]


# ------------------------------------------------------------ plan building

def build_segments(text, base):
    """Parse markers + sentences into segments carrying an energy each.

    `base` is (start, end) energy for the slide when the script says nothing.
    """
    items = []          # {'text','span','para_break','beat'}
    spans = {0: None}   # span id -> (a, b) or None for "use the slide base"
    span = 0
    pos = 0

    def emit(chunk):
        paras = re.split(r'\n\s*\n', chunk)
        for pi, para in enumerate(paras):
            sents = split_sentences(para, CFG.max_words)
            for si, s in enumerate(sents):
                items.append({'text': s, 'span': span, 'beat': 0.0,
                              'para_break': (si == len(sents) - 1
                                             and pi < len(paras) - 1)})

    for m in MARKER.finditer(text):
        emit(text[pos:m.start()])
        pos = m.end()
        a, b, beat = m.group(1), m.group(2), m.group(3)
        if a is not None:
            span += 1
            spans[span] = (clamp(float(a)), clamp(float(b if b else a)))
        else:
            secs = float(beat) if beat else 0.45
            if items:
                items[-1]['beat'] = max(items[-1]['beat'], secs)
    emit(text[pos:])

    items = _merge_fragments(items)
    if not items:
        return items

    # Energy per segment: explicit spans interpolate across their own
    # sentences; unmarked text follows the slide base with a gentle rise, so
    # even a plain script lifts toward its last line instead of flatlining.
    by_span = {}
    for i, it in enumerate(items):
        by_span.setdefault(it['span'], []).append(i)
    n = len(items)
    for sid, idxs in by_span.items():
        spec = spans.get(sid)
        for k, i in enumerate(idxs):
            if spec is None:
                t = 0.0 if n == 1 else i / (n - 1)
                items[i]['energy'] = clamp(base[0] + (base[1] - base[0]) * t)
            else:
                a, b = spec
                t = 0.0 if len(idxs) == 1 else k / (len(idxs) - 1)
                items[i]['energy'] = clamp(a + (b - a) * t)
    return items


def _merge_fragments(items):
    """A one-word orphan reads as a stutter; fold it into its neighbour."""
    out = []
    for it in items:
        if out and len(it['text'].split()) < 2:
            out[-1]['text'] += ' ' + it['text']
            out[-1]['beat'] = max(out[-1]['beat'], it['beat'])
            out[-1]['para_break'] = it['para_break']
        else:
            out.append(it)
    return out


def _jitter(text, spread):
    """Deterministic per-sentence wobble: same script always builds the same
    audio, but no two sentences share an exact setting."""
    h = hashlib.sha1(text.encode('utf-8')).digest()
    return ((h[0] / 255.0) * 2 - 1) * spread, ((h[1] / 255.0) * 2 - 1) * spread


def plan_slide(cfg, index, curve):
    n = f"{index:02d}"
    src = cfg.narration / f"slide{n}.txt"
    if not src.exists():
        die(f"missing {src}")
    if index in curve:
        base = curve[index]
    elif cfg.curve_default == 'auto':
        e = auto_arc(index, cfg.slides or index)
        base = (e, clamp(e + cfg.rise))
    else:
        e = clamp(float(cfg.curve_default))
        base = (e, clamp(e + cfg.rise))

    segs = build_segments(src.read_text(), base)
    if not segs:
        die(f"{src} has no narration text")

    r0, r1 = cfg.rate
    p0, p1 = cfg.pitch
    v0, v1 = cfg.volume
    g0, g1 = cfg.gap

    for i, s in enumerate(segs):
        e = s['energy']
        jr, jp = _jitter(s['text'], 1.2) if cfg.jitter else (0.0, 0.0)
        k = ease(e)
        s['rate'] = round(r0 + (r1 - r0) * k + jr)
        s['pitch'] = round(p0 + (p1 - p0) * k + jp * 0.4)
        s['volume'] = round(v0 + (v1 - v0) * e)   # loudness is the real lever
        # F5-TTS speed multiplier for the voice-clone renderer.
        s['speed'] = round(0.94 + 0.14 * k, 3)

        nxt = segs[i + 1]['energy'] if i + 1 < len(segs) else None
        gap = g0 + (g1 - g0) * e
        why = []
        if s['para_break']:
            gap += 0.35
            why.append('para')
        if nxt is not None and nxt - e >= 0.25:
            # The breath before the punch line. This one pause does more for
            # believability than any amount of rate tuning.
            gap += 0.20 + 0.50 * (nxt - e)
            why.append('anticipate')
        if nxt is not None and e >= 0.85 and nxt < e - 0.10:
            gap += 0.30
            why.append('land')
        if s['beat']:
            gap = max(gap, s['beat'])
            why.append('beat')
        s['gap'] = 0.0 if nxt is None else round(max(gap, 0.08), 2)
        s['why'] = ','.join(why) or '-'
        s['band'] = band_for(e)
    return segs


# Voice-clone renderer: excitement cannot be dialled in with DSP, it has to be
# present in the reference recording. Each band points at a span of your own
# voice at that energy, and every sentence is cloned from the band it needs.
BANDS = [(0.45, 'calm'), (0.75, 'mid')]


def band_for(e):
    for thresh, name in BANDS:
        if e < thresh:
            return name
    return 'hot'


# ------------------------------------------------------------------ synth

def edge_args(cfg, seg):
    return [cfg.edge_bin, '--voice', cfg.voice,
            f"--rate={seg['rate']:+d}%",
            f"--pitch={seg['pitch']:+d}Hz",
            f"--volume={seg['volume']:+d}%",
            '--text', seg['text']]


def synth_slide(cfg, index, segs, out_path):
    """Synthesize each sentence, then join with the planned silences."""
    with tempfile.TemporaryDirectory(prefix='slidemaker-') as tmp:
        tmp = Path(tmp)
        parts = []          # ffmpeg inputs, in order
        for i, seg in enumerate(segs):
            piece = tmp / f"{i:03d}.mp3"
            cmd = edge_args(cfg, seg) + ['--write-media', str(piece)]
            proc = subprocess.run(cmd, capture_output=True, text=True)
            if proc.returncode != 0 or not piece.exists() or piece.stat().st_size == 0:
                die(f"edge-tts failed on slide {index:02d} sentence {i + 1}:\n"
                    f"  {seg['text'][:70]}\n  {proc.stderr.strip()[:300]}")
            parts.append(('file', piece))
            if seg['gap'] > 0:
                parts.append(('silence', seg['gap']))

        cmd = ['ffmpeg', '-v', 'error', '-y']
        for kind, val in parts:
            if kind == 'file':
                cmd += ['-i', str(val)]
            else:
                cmd += ['-f', 'lavfi', '-t', f'{val:.2f}',
                        '-i', 'anullsrc=r=24000:cl=mono']
        chains = ''.join(
            f'[{j}:a]aresample=24000,aformat=sample_fmts=fltp:'
            f'channel_layouts=mono[a{j}];' for j in range(len(parts)))
        chains += ''.join(f'[a{j}]' for j in range(len(parts)))
        chains += f'concat=n={len(parts)}:v=0:a=1[out]'
        cmd += ['-filter_complex', chains, '-map', '[out]',
                '-c:a', 'libmp3lame', '-q:a', '2', '-ar', '24000', '-ac', '1',
                str(out_path)]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            die(f"ffmpeg join failed on slide {index:02d}:\n{proc.stderr.strip()[:400]}")


def write_plan(path, segs):
    lines = ['# energy\trate\tpitch\tvol\tgap\treason\ttext']
    for s in segs:
        lines.append(f"{s['energy']:.2f}\t{s['rate']:+d}%\t{s['pitch']:+d}Hz\t"
                     f"{s['volume']:+d}%\t{s['gap']:.2f}\t{s['why']}\t{s['text']}")
    path.write_text('\n'.join(lines) + '\n')


# ----------------------------------------------------------------- reports

def bar(e, width=18):
    filled = int(round(e * width))
    return '█' * filled + '·' * (width - filled)


def cmd_plan(cfg, args):
    curve = load_curve(cfg)
    total_words = total_gap = 0
    for i in slide_range(cfg, args):
        segs = plan_slide(cfg, i, curve)
        lo = min(s['energy'] for s in segs)
        hi = max(s['energy'] for s in segs)
        print(f"\nslide {i:02d}  {len(segs)} sentences  energy {lo:.2f}–{hi:.2f}")
        for s in segs:
            words = len(s['text'].split())
            total_words += words
            total_gap += s['gap']
            preview = s['text'] if len(s['text']) <= 58 else s['text'][:55] + '...'
            print(f"  {bar(s['energy'])} {s['energy']:.2f} "
                  f"{s['rate']:+3d}% {s['pitch']:+3d}Hz {s['volume']:+2d}% "
                  f"gap {s['gap']:.2f} {s['why']:<10} {preview}")
    print(f"\n{total_words} words, {total_gap:.1f}s of planned silence")


def cmd_json(cfg, args):
    """Emit the whole deck plan for the voice-clone renderer on the GPU host."""
    curve = load_curve(cfg)
    deck = []
    for i in slide_range(cfg, args):
        segs = plan_slide(cfg, i, curve)
        deck.append({'slide': f"{i:02d}",
                     'segments': [{'text': s['text'], 'energy': round(s['energy'], 3),
                                   'speed': s['speed'], 'gap': s['gap'],
                                   'band': s['band']} for s in segs]})
    json.dump({'slides': deck}, sys.stdout, indent=1)
    sys.stdout.write('\n')


def cmd_synth(cfg, args):
    curve = load_curve(cfg)
    cfg.tts_dir.mkdir(parents=True, exist_ok=True)
    for i in slide_range(cfg, args):
        out = cfg.tts_dir / f"slide{i:02d}.mp3"
        if out.exists() and not args.force:
            continue
        segs = plan_slide(cfg, i, curve)
        synth_slide(cfg, i, segs, out)
        write_plan(cfg.tts_dir / f"slide{i:02d}.plan.tsv", segs)
        lo = min(s['energy'] for s in segs)
        hi = max(s['energy'] for s in segs)
        print(f"{out}  ({len(segs)} sentences, energy {lo:.2f}–{hi:.2f})")


def cmd_curve_init(cfg, args):
    path = cfg.narration / cfg.curve_file
    if path.exists() and not args.force:
        die(f"{path} exists (use --force to overwrite)")
    if not cfg.slides:
        die("SLIDES is not set")
    lines = [
        "# slidemaker excitement curve — one line per slide.",
        "#   SLIDE  ENERGY      0.0 flat and calm .. 1.0 peak excitement",
        "#   SLIDE  A>B         ramp across the slide",
        "# Inline [e=...] markers in the narration text override these.",
        "# Seeded from the default talk arc: hook, settle, build, land.",
    ]
    for i in range(1, cfg.slides + 1):
        e = auto_arc(i, cfg.slides)
        lines.append(f"{i:02d}\t{e:.2f}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text('\n'.join(lines) + '\n')
    print(f"wrote {path} — edit it, then: slidemaker curve")


def cmd_report(cfg, args):
    """Measure what was actually built. Flat audio is the failure mode; this
    makes it visible instead of leaving it to the ear."""
    d = Path(args.dir) if args.dir else cfg.tts_dir
    rows = []
    for i in slide_range(cfg, args):
        aud = next((d / f"slide{i:02d}.{ext}" for ext in ('mp3', 'wav', 'm4a', 'aiff')
                    if (d / f"slide{i:02d}.{ext}").exists()), None)
        if aud is None:
            continue
        dur = float(subprocess.run(
            ['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
             '-of', 'csv=p=0', str(aud)],
            capture_output=True, text=True).stdout.strip() or 0)
        vol = subprocess.run(['ffmpeg', '-i', str(aud), '-af', 'volumedetect',
                              '-f', 'null', '-'],
                             capture_output=True, text=True).stderr
        mean = _grab(vol, 'mean_volume')
        peak = _grab(vol, 'max_volume')
        txt = cfg.narration / f"slide{i:02d}.txt"
        words = len(MARKER.sub('', txt.read_text()).split()) if txt.exists() else 0
        wps = words / dur if dur else 0
        rows.append((i, dur, wps, mean, peak))

    if not rows:
        die(f"no built audio found in {d}")
    print(f"{'slide':>5} {'dur':>7} {'words/s':>8} {'mean dB':>8} {'peak dB':>8}")
    for i, dur, wps, mean, peak in rows:
        print(f"{i:>5} {dur:>7.1f} {wps:>8.2f} {mean:>8.1f} {peak:>8.1f}")
    wps_sd = _stdev([r[2] for r in rows])
    mean_sd = _stdev([r[3] for r in rows])
    print(f"\nspeaking-rate spread: {wps_sd:.3f} words/s (sd)"
          f"   loudness spread: {mean_sd:.2f} dB (sd)")
    if wps_sd < 0.05:
        print("WARNING: near-zero rate variation — this is the flat, "
              "obviously-synthetic profile. Check EXCITEMENT and the curve.")


def _grab(text, key):
    m = re.search(rf'{key}:\s*(-?[0-9.]+) dB', text)
    return float(m.group(1)) if m else float('nan')


def _stdev(xs):
    xs = [x for x in xs if not math.isnan(x)]
    if len(xs) < 2:
        return 0.0
    mu = sum(xs) / len(xs)
    return math.sqrt(sum((x - mu) ** 2 for x in xs) / (len(xs) - 1))


def slide_range(cfg, args):
    if getattr(args, 'slide', None):
        return [args.slide]
    if not cfg.slides:
        die("SLIDES is not set")
    return range(1, cfg.slides + 1)


# -------------------------------------------------------------------- main

def main():
    global CFG
    ap = argparse.ArgumentParser(prog='slidemaker-prosody', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)
    for name in ('plan', 'json', 'synth', 'report', 'curve-init'):
        p = sub.add_parser(name)
        p.add_argument('--slide', type=int)
        p.add_argument('--force', action='store_true')
        if name == 'report':
            p.add_argument('dir', nargs='?')
    args = ap.parse_args()
    CFG = Config()
    {'plan': cmd_plan, 'json': cmd_json, 'synth': cmd_synth,
     'report': cmd_report, 'curve-init': cmd_curve_init}[args.cmd](CFG, args)


CFG = Config()

if __name__ == '__main__':
    main()
